{
  "manifest_version": 3,
  "name": "Chrome Cat",
  "description": "Scan any page, then chat about it with the browser's built-in model. Everything stays local. The cat helps.",
  "version": "0.5.0",
  "minimum_chrome_version": "138",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "tabs", "downloads", "tts", "history", "bookmarks"],
  "omnibox": { "keyword": "cc" },
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Chat about this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
